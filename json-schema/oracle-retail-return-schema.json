{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/Return",
  "title": "Return",
  "type": "object",
  "properties": {
    "returnId": {
      "type": "string"
    },
    "orderId": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "PENDING",
        "APPROVED",
        "RECEIVED",
        "REFUNDED"
      ]
    },
    "lines": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "lineId": {
            "type": "string"
          },
          "quantity": {
            "type": "integer"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    "createDatetime": {
      "type": "string",
      "format": "date-time"
    }
  }
}