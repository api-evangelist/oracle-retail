{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/OrderCreate",
  "title": "OrderCreate",
  "type": "object",
  "required": [
    "externalOrderId",
    "channelId",
    "customerId",
    "currencyCode",
    "lines"
  ],
  "properties": {
    "externalOrderId": {
      "type": "string"
    },
    "channelId": {
      "type": "string"
    },
    "customerId": {
      "type": "string"
    },
    "currencyCode": {
      "type": "string",
      "maxLength": 3
    },
    "shippingAddress": {
      "$ref": "#/components/schemas/Address"
    },
    "lines": {
      "type": "array",
      "items": {
        "$ref": "#/components/schemas/OrderLineCreate"
      }
    }
  }
}