{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/ReturnCreate",
  "title": "ReturnCreate",
  "type": "object",
  "required": [
    "orderId",
    "lines"
  ],
  "properties": {
    "orderId": {
      "type": "string"
    },
    "lines": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "lineId",
          "quantity",
          "reason"
        ],
        "properties": {
          "lineId": {
            "type": "string"
          },
          "quantity": {
            "type": "integer"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    }
  }
}