{
  "opencollection": "1.0.0",
  "info": {
    "name": "Oracle Retail Merchandising Foundation Cloud Service Fulfillment Suppliers API",
    "version": "26.1.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "https://identity.oraclecloud.com/oauth2/v1/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Suppliers",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List suppliers",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{host}/MerchServices/MerchRes/v1/suppliers",
            "params": [
              {
                "name": "status",
                "value": "",
                "type": "query"
              },
              {
                "name": "offset",
                "value": "",
                "type": "query"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Returns supplier master data including contact and payment terms."
        }
      ]
    }
  ],
  "bundled": true
}