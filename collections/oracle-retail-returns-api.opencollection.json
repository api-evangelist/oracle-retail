{
  "opencollection": "1.0.0",
  "info": {
    "name": "Oracle Retail Merchandising Foundation Cloud Service Fulfillment Returns API",
    "version": "26.1.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "https://identity.oraclecloud.com/oauth2/v1/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Returns",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Create a return",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{host}/MerchServices/MerchRes/v1/returns",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Initiates a customer return authorization for one or more order lines."
        }
      ]
    }
  ],
  "bundled": true
}